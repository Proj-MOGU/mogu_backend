  "info" : {
    "description" : "MOGU 서비스의 API 계약입니다.",
    "title" : "MOGU API",
    "version" : "v1"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/api/auth/identity-verification" : {
      "post" : {
        "description" : "가입 대기 토큰과 연결된 본인인증 결과로 가입하거나 기존 계정에 로그인 방식을 연결한다. newMember가 true이면 프로필 입력 화면으로 이동한다.",
        "operationId" : "verify",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/IdentityVerificationRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/IdentityVerificationResponse"
                }
              }
            },
            "description" : "본인인증 및 로그인 성공"
          },
          "400" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description" : "입력값 오류 (COMMON_INVALID_INPUT); 본인인증 정보 확인 실패 (AUTH_INVALID_IDENTITY_VERIFICATION)"
          },
          "401" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description" : "인증이 필요하거나 토큰이 유효하지 않음 (AUTH_UNAUTHORIZED)"
          },
          "403" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description" : "이용이 제한된 계정 (AUTH_ACCOUNT_SANCTIONED)"
          },
          "409" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description" : "같은 로그인 방식의 다른 계정이 이미 연결됨 (AUTH_PROVIDER_ALREADY_LINKED)"
          },
          "429" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description" : "요청이 너무 많음 (AUTH_TOO_MANY_REQUESTS)",
            "headers" : {
              "Retry-After" : {
                "description" : "재시도까지 대기할 초 (정수, 올림)",
                "schema" : {
                  "type" : "integer"
                },
                "style" : "simple"
              }
            }
          }
        },
        "security" : [
          {
            "registrationToken" : [ ]
          }
        ],
        "summary" : "본인인증으로 가입 완료",
        "tags" : [
          "본인인증"
        ]
      }
    },
    "/api/auth/login/{provider}" : {
      "post" : {
        "description" : "응답의 registrationRequired가 true이면 본인인증으로 가입을 마쳐야 한다.",
        "operationId" : "login",
        "parameters" : [
          {
            "description" : "소셜 로그인 제공자",
            "example" : "kakao",
            "in" : "path",
            "name" : "provider",
            "required" : true,
            "schema" : {
              "enum" : [
                "kakao",
                "google"
              ],
              "type" : "string"
            }
          }
        ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/LoginRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/LoginResponse"
                }
              }
            },
            "description" : "로그인 성공 또는 가입 대기"
          },
          "400" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description" : "지원하지 않는 로그인 방식 (AUTH_UNSUPPORTED_PROVIDER); 입력값 오류 (COMMON_INVALID_INPUT)"
          },
          "401" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description" : "소셜 로그인 정보 확인 실패 (AUTH_INVALID_SOCIAL_TOKEN)"
          },
          "403" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description" : "이용이 제한된 계정 (AUTH_ACCOUNT_SANCTIONED)"
          },
          "429" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description" : "요청이 너무 많음 (AUTH_TOO_MANY_REQUESTS)",
            "headers" : {
              "Retry-After" : {
                "description" : "재시도까지 대기할 초 (정수, 올림)",
                "schema" : {
                  "type" : "integer"
                },
                "style" : "simple"
              }
            }
          },
          "503" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description" : "소셜 로그인 서비스 일시 장애 (AUTH_PROVIDER_UNAVAILABLE)"
          }
        },
        "security" : [ ],
        "summary" : "소셜 로그인",
        "tags" : [
          "인증"
        ]
      }
    },
