    "/api/auth/refresh" : {
      "post" : {
        "description" : "앱은 refresh 요청을 동시에 보내지 않는다. 이미 쓴 토큰을 다시 보내면 그 로그인 묶음 전체가 폐기된다.",
        "operationId" : "refresh",
